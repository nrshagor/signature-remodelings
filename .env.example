# Public site URL: used for metadataBase, canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://signatureremodelings.com

# Search indexing. false (default, staging/preview): robots.txt disallows everything and
# every page is noindex. Set to true only on the live production site at launch.
SITE_INDEXABLE=false

# Contact form delivery: filled in after the T2.9 decision (SMTP or email API).
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
